# WordPress API URL (no trailing slash)
# Local: http://cms.tahirhafeez.local
# Production: https://cms.tahirhafeez.com
WORDPRESS_API_URL=

# Revalidate cached WordPress data every N seconds (default: 3600 = 1 hour)
REVALIDATE_SECONDS=3600

# Secret for /api/revalidate webhook (match WordPress Headless CMS settings)
REVALIDATE_SECRET=change-me-to-a-random-string

# Public URLs (safe to expose in browser)
NEXT_PUBLIC_BOOKING_URL=https://your-ghl-calendar-link.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@tahirhafeez.com
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-profile
NEXT_PUBLIC_UPWORK_URL=https://upwork.com/freelancers/your-profile
NEXT_PUBLIC_FIVERR_URL=https://fiverr.com/your-profile
NEXT_PUBLIC_CLUTCH_URL=https://clutch.co/profile/your-profile
