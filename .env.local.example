# WordPress API URL (no trailing slash)
# Local: http://cms.tahirhafeez.local
# Production: https://cms.tahirhafeez.com
WORDPRESS_API_URL=

# Revalidate cached WordPress data every N seconds (default: 3600 = 1 hour)
REVALIDATE_SECONDS=3600

# Secret for /api/revalidate webhook (match WordPress Headless CMS settings)
